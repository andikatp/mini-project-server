{
  "name": "mini-project-server",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun run prisma:generate",
    "start": "bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7",
    "@prisma/client": "7",
    "argon2": "^0.45.1",
    "crypto": "^1.0.1",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}