{
  "name": "mini-project-server",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun run prisma:generate",
    "start": "bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7",
    "@prisma/client": "7",
    "@types/cookie-parser": "^1.4.10",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "resend": "^6.34.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
