enum TransactionStatus {
    WAITING_FOR_PAYMENT
    WAITING_FOR_ADMIN_CONFIRMATION
    DONE
    REJECTED
    EXPIRED
    CANCELED
}

enum ReviewStatus {
    PENDING
    APPROVED
    REJECTED
}

model Transaction {
    id                  String            @id @default(uuid())
    code                String            @unique
    customerId          String            @map("customer_id")
    eventId             String            @map("event_id")
    status              TransactionStatus @default(WAITING_FOR_PAYMENT)
    subtotalIdr         Int               @default(0) @map("subtotal_idr")
    voucherDiscountIdr  Int               @default(0) @map("voucher_discount_idr")
    couponDiscountIdr   Int               @default(0) @map("coupon_discount_idr")
    pointsUsed          Int               @default(0) @map("points_used")
    totalIdr            Int               @default(0) @map("total_idr")
    paymentExpiresAt    DateTime          @map("payment_expires_at")
    proofUploadedAt     DateTime?         @map("proof_uploaded_at")
    confirmationDueAt   DateTime?         @map("confirmation_due_at")
    rollbackProcessedAt DateTime?         @map("rollback_processed_at")
    createdAt           DateTime          @default(now()) @map("created_at")
    updatedAt           DateTime          @updatedAt @map("updated_at")

    customer         User              @relation("CustomerTransactions", fields: [customerId], references: [id], onDelete: Cascade)
    event            Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
    items            TransactionItem[]
    paymentProof     PaymentProof?
    pointAllocations PointAllocation[]

    @@index([customerId, status])
    @@index([eventId, status])
    @@index([paymentExpiresAt])
    @@index([confirmationDueAt])
    @@map("transactions")
}

model TransactionItem {
    id            String   @id @default(uuid())
    transactionId String   @map("transaction_id")
    ticketTypeId  String   @map("ticket_type_id")
    ticketName    String   @map("ticket_name")
    priceIdr      Int      @map("price_idr")
    quantity      Int      @default(1)
    subtotalIdr   Int      @map("subtotal_idr")
    createdAt     DateTime @default(now()) @map("created_at")

    transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    ticketType  TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

    @@map("transaction_items")
}

model PaymentProof {
    id              String    @id @default(uuid())
    transactionId   String    @unique @map("transaction_id")
    fileUrl         String    @map("file_url")
    reviewedByUserId String?  @map("reviewed_by_user_id")
    rejectionReason String?   @map("rejection_reason")
    uploadedAt      DateTime  @default(now()) @map("uploaded_at")
    reviewedAt      DateTime? @map("reviewed_at")

    transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    reviewedBy  User?       @relation("ProofReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

    @@map("payment_proofs")
}

model Review {
    id               String       @id @default(uuid())
    customerId       String       @map("customer_id")
    eventId          String       @map("event_id")
    rating           Int
    comment          String?
    status           ReviewStatus @default(PENDING)
    rejectionReason  String?      @map("rejection_reason")
    reviewedByUserId String?      @map("reviewed_by_user_id")
    createdAt        DateTime     @default(now()) @map("created_at")
    updatedAt        DateTime     @updatedAt @map("updated_at")

    customer   User  @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
    event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
    reviewedBy User? @relation("ReviewReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

    @@unique([customerId, eventId])
    @@map("reviews")
}

