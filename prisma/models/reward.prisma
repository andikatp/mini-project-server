enum PointAllocationStatus {
    RESERVED
    FINALIZED
    ROLLED_BACK
}

model PointCredit {
    id              String   @id @default(uuid())
    userId          String   @map("user_id")
    initialAmount   Int      @default(10000) @map("initial_amount")
    remainingAmount Int      @default(10000) @map("remaining_amount")
    issuedAt        DateTime @default(now()) @map("issued_at")
    expiresAt       DateTime @map("expires_at")

    user        User              @relation("ReferrerPoints", fields: [userId], references: [id], onDelete: Cascade)
    allocations PointAllocation[]

    @@map("point_credits")
}

model PointAllocation {
    id            String                @id @default(uuid())
    transactionId String                @map("transaction_id")
    pointCreditId String                @map("point_credit_id")
    amountUsed    Int                   @map("amount_used")
    status        PointAllocationStatus @default(RESERVED)
    createdAt     DateTime              @default(now()) @map("created_at")
    reversedAt    DateTime?             @map("reversed_at")

    // transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    pointCredit PointCredit @relation(fields: [pointCreditId], references: [id], onDelete: Cascade)

    @@map("point_allocations")
}
